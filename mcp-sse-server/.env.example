# MCP Server Configuration

# Server Port
MCP_PORT=3000

# Authentication Token (optional - leave empty to disable auth and rely on ZeroTier network isolation)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_AUTH_TOKEN=

# CORS Configuration (comma-separated origins)
# Use '*' for development, specific domains/IPs for production
ALLOWED_ORIGINS=*

# Optional: IP Whitelist (not implemented yet, for future enhancement)
# IP_WHITELIST=172.28.0.150,172.28.0.200
