# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AUTH_USERNAME: Master admin username for application authentication.
AUTH_USERNAME="www.yefriharyanto.id"

# AUTH_PASSWORD: Master admin password for application authentication.
AUTH_PASSWORD="123456"

# PENGATURAN DATABASE ISOLATION & CONFIGURATION
# Standard environment variables for database isolation on Menu Pengaturan.
# When remixing or cloning this project, configure your own database credentials here:
VITE_PENGATURAN_FIREBASE_API_KEY=""
VITE_PENGATURAN_FIREBASE_PROJECT_ID=""
VITE_PENGATURAN_FIREBASE_DATABASE_ID=""
VITE_PENGATURAN_FIREBASE_AUTH_DOMAIN=""
VITE_PENGATURAN_FIREBASE_STORAGE_BUCKET=""
VITE_PENGATURAN_FIREBASE_MESSAGING_SENDER_ID=""
VITE_PENGATURAN_FIREBASE_APP_ID=""

# FIREBASE CONFIGURATION (OPTIONAL FOR REMIX / CLONED PROJECTS)
# When remixing or cloning this project, configure your own Firebase credentials here:
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_DATABASE_ID=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# SIAKAD SSO CONFIGURATION
# Mock Mode (for development without real SIAKAD)
# Set to 'true' to use mock SIAKAD server, 'false' to use real SIAKAD
VITE_SIAKAD_MOCK_MODE=true

# Mock SIAKAD Server URLs (used when VITE_SIAKAD_MOCK_MODE=true)
# Default mock server runs on localhost:3001
VITE_SIAKAD_AUTH_URL=http://localhost:3001/oauth/authorize
VITE_SIAKAD_TOKEN_URL=http://localhost:3001/oauth/token

# Real SIAKAD Configuration (used when VITE_SIAKAD_MOCK_MODE=false)
# Uncomment and configure these when switching to real SIAKAD
# VITE_SIAKAD_AUTH_URL=https://siakad.example.com/oauth/authorize
# VITE_SIAKAD_TOKEN_URL=https://siakad.example.com/oauth/token

# Client credentials (same for both mock and real)
VITE_SIAKAD_CLIENT_ID=apk_gen_client
VITE_SIAKAD_REDIRECT_URI=http://localhost:5173/auth/callback

# Feature flags
VITE_SIAKAD_ENABLED=true
VITE_FALLBACK_LOCAL_AUTH_ENABLED=true
